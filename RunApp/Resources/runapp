#!/usr/bin/env bash
# runapp — open a folder or Xcode project in RunApp, like `xed`.
#   runapp            # current folder
#   runapp path/to/App.xcodeproj
set -euo pipefail

target="${1:-.}"
if [[ ! -e "$target" ]]; then
  echo "runapp: no such file or directory: $target" >&2
  exit 1
fi
if [[ -d "$target" && "$target" != *.xcodeproj && "$target" != *.xcworkspace ]]; then
  abs="$(cd "$target" && pwd -P)"
else
  abs="$(cd "$(dirname "$target")" && pwd -P)/$(basename "$target")"
fi

# Find RunApp: $RUNAPP_APP, the app this script ships in (RunApp › Install Command Line Tool… symlinks
# RunApp.app/Contents/Resources/runapp), /Applications, ~/Applications, then the newest Debug build in DerivedData.
app="${RUNAPP_APP:-}"
if [[ -z "$app" ]]; then
  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  if [[ "$self" == */Contents/Resources/runapp ]]; then
    bundle="${self%/Contents/Resources/runapp}"
    [[ "$bundle" == *.app && -d "$bundle" ]] && app="$bundle"
  fi
fi
if [[ -z "$app" ]]; then
  for candidate in "/Applications/RunApp.app" "$HOME/Applications/RunApp.app"; do
    [[ -d "$candidate" ]] && app="$candidate" && break
  done
fi
if [[ -z "$app" ]]; then
  app="$(ls -dt "$HOME"/Library/Developer/Xcode/DerivedData/RunApp-*/Build/Products/*/RunApp.app 2>/dev/null | head -n 1 || true)"
fi
if [[ -z "$app" ]]; then
  echo "runapp: RunApp.app not found in /Applications or DerivedData (set RUNAPP_APP=/path/to/RunApp.app)" >&2
  exit 1
fi

if pgrep -qx RunApp; then
  # Already running: --args would be ignored, so deliver the path as an open-document event.
  open -a "$app" "$abs"
else
  open -a "$app" --args "$abs"
fi
